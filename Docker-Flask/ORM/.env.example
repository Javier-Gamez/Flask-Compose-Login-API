# Copia este archivo como ".env" en la misma carpeta y ajusta los valores.
# El archivo ".env" real NUNCA debe subirse al repositorio (ver .gitignore).

# Credenciales de la base de datos Postgres
POSTGRES_DB=notesdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Clave usada para firmar los tokens JWT de sesion. Usa un valor largo y aleatorio.
JWT_SECRET_KEY=change-this-secret-in-production

# Minutos de vigencia del token de sesion
JWT_EXP_MINUTES=60
